kernel_usage() {
    [[ -n "$LANGUAGE" ]] || LANGUAGE=en
    print_banner kernel
    if [[ "$LANGUAGE" == zh ]]; then
        cat <<'EOF'
uwu kernel migrate - 将 legacy 内核配置转换为 uwu_kernel

用法：
  uwu kernel migrate [plan] (--device NAME | --device-dir PATH) [选项]
  uwu kernel migrate apply (--device NAME | --device-dir PATH) [选项]

选项：
  --device NAME                 设备代号；自动解析继承的公共 BoardConfig
  --device-dir PATH             设备树目录，例如 device/oneplus/sm8550-common
  --board-config PATH           显式指定 BoardConfig 文件
  --format FORMAT               text 或 json
  -h, --help                    显示帮助

plan 会显示生成的 uwu_kernel 和所有阻塞项。存在不能无损映射的配置时，apply
会拒绝修改文件。转换器不会用不完整配置静默替换 legacy 构建。
EOF
    else
        cat <<'EOF'
uwu kernel migrate - Convert legacy kernel settings to uwu_kernel

Usage:
  uwu kernel migrate [plan] (--device NAME | --device-dir PATH) [options]
  uwu kernel migrate apply (--device NAME | --device-dir PATH) [options]

Options:
  --device NAME                 Device codename; inherited common BoardConfigs are resolved
  --device-dir PATH             Device tree directory, for example device/oneplus/sm8550-common
  --board-config PATH           Select a BoardConfig file explicitly
  --format FORMAT               text or json
  -h, --help                    Show this help

plan prints the generated uwu_kernel and every blocker. apply refuses to modify files when a
setting cannot be converted without losing behavior.
EOF
    fi
}

kernel_migrate_main() {
    local action=plan
    if [[ "${1:-}" == plan || "${1:-}" == apply ]]; then
        action="$1"
        shift
    fi
    local -a args=("$action")
    local output_format=text
    while (( $# )); do
        case "$1" in
            --device|--device-dir|--board-config)
                [[ $# -ge 2 ]] || die "$1 requires a value" 2
                args+=("$1" "$2")
                shift 2
                ;;
            --format)
                [[ $# -ge 2 ]] || die "$1 requires a value" 2
                output_format="$2"
                args+=("$1" "$2")
                shift 2
                ;;
            -h|--help)
                kernel_usage
                return 0
                ;;
            *) die "Unknown option: $1" 2 ;;
        esac
    done
    local have_device=false arg
    for arg in "${args[@]}"; do
        [[ "$arg" == --device || "$arg" == --device-dir ]] && have_device=true
    done
    $have_device || die "--device or --device-dir is required" 2
    require_source_tree
    if [[ "$output_format" == text ]]; then
        print_banner kernel
    fi
    python3 "$SCRIPT_DIR/kernel_migrate.py" "${args[@]}"
}

vendor_convert_radio_main() {
    local device_dir
    while (( $# )); do
        case "$1" in
            --device) [[ $# -ge 2 ]] || die "--device requires a value" 2; DEVICE="$2"; shift 2 ;;
            --product-file) [[ $# -ge 2 ]] || die "--product-file requires a value" 2; PRODUCT_FILE="$2"; shift 2 ;;
            --yes) YES=true; shift ;;
            --non-interactive) NON_INTERACTIVE=true; shift ;;
            -h|--help) radio_usage; return 0 ;;
            *) die "Unknown option: $1" 2 ;;
        esac
    done
    require_source_tree
    step 'Scanning product trees'
    find_candidates
    step 'Selecting product tree'
    select_product
    device_dir="$(dirname -- "$SELECTED_PRODUCT_FILE")"
    step 'Converting radio files'
    vendor_convert_radio "$device_dir"
}

cleanup() {
    [[ -z "${PRODUCT_TMP:-}" ]] || rm -f -- "$PRODUCT_TMP"
    [[ -z "${ANDROID_PRODUCTS_TMP:-}" ]] || rm -f -- "$ANDROID_PRODUCTS_TMP"
    return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

parse_options() {
    while (( $# )); do
        case "$1" in
            --device) [[ $# -ge 2 ]] || die "--device requires a value" 2; DEVICE="$2"; shift 2 ;;
            --product-file) [[ $# -ge 2 ]] || die "--product-file requires a value" 2; PRODUCT_FILE="$2"; shift 2 ;;
            --type) [[ $# -ge 2 ]] || die "--type requires a value" 2; DEVICE_TYPE="$2"; shift 2 ;;
            --telephony) SUPPORTS_TELEPHONY=true; shift ;;
            --no-telephony) SUPPORTS_TELEPHONY=false; shift ;;
            --dry-run) DRY_RUN=true; shift ;;
            --yes) YES=true; shift ;;
            --non-interactive) NON_INTERACTIVE=true; shift ;;
            --format) [[ $# -ge 2 ]] || die "--format requires a value" 2; FORMAT="$2"; shift 2 ;;
            --language) [[ $# -ge 2 ]] || die "--language requires a value" 2; LANGUAGE="$2"; shift 2 ;;
            -h|--help) product_usage; exit 0 ;;
            *) die "Unknown option: $1" 2 ;;
        esac
    done
    [[ "$FORMAT" == text || "$FORMAT" == json ]] || die "Unsupported format: $FORMAT" 2
    validate_language
}

main() {
    [[ "${1:-}" == product && "${2:-}" == migrate && "${3:-}" == lineage ]] || { global_usage; exit 2; }
    shift 3
    local format_action="${1:-plan}"
    if [[ "$format_action" == list || "$format_action" == check || "$format_action" == plan || "$format_action" == apply ]]; then
        shift
    else
        format_action=plan
    fi
    parse_options "$@"
    require_source_tree
    print_banner
    step 'Scanning product trees'
    find_candidates
    if [[ "$format_action" == list ]]; then print_candidates; exit 0; fi
    (( ${#CANDIDATES[@]} )) || die "No convertible product tree was found. Run 'uwu product migrate lineage list'."
    step 'Selecting product tree'
    select_product
    step 'Collecting device options'
    ask_options
    step 'Validating source files'
    validate_product
    status_line '✓' "$GREEN" 'Validation' 'passed'
    step 'Preparing migration preview'
    make_plan
    if [[ "$FORMAT" == json ]]; then
        printf '{"operation":"product.migrate.lineage","device":"%s","product":"%s","target":"%s","device_type":"%s","telephony":%s,"changed":true}\n' "$PRODUCT_SUFFIX" "$LINEAGE_PRODUCT" "$UWU_PRODUCT" "$DEVICE_TYPE" "$SUPPORTS_TELEPHONY"
    else
        print_plan
    fi
    [[ "$format_action" == check || "$format_action" == plan || "$DRY_RUN" == true ]] && exit 0
    confirm_apply
    step 'Applying migration'
    apply_plan
    status_line '✓' "$GREEN" 'Files changed' '2'
    msg success "$(relative_path "$UWU_PRODUCT_FILE")"

    step 'Vendor radio migration'
    local vendor_root answer
    vendor_root="$(vendor_root_from_device_dir "$DEVICE_DIR")"
    if [[ ! -d "$vendor_root" ]]; then
        msg vendor_missing "$(relative_path "$vendor_root")"
    elif $YES; then
        vendor_convert_radio "$DEVICE_DIR"
    elif ! $NON_INTERACTIVE; then
        msg radio_confirm
        read -r answer || die "No input received."
        if [[ "$answer" =~ ^(y|Y|yes|Yes)$ ]]; then
            vendor_convert_radio "$DEVICE_DIR"
        fi
    fi

    step 'Kernel migration'
    if python3 "$SCRIPT_DIR/kernel_migrate.py" apply --device-dir "$(relative_path "$DEVICE_DIR")" --format json >/dev/null; then
        status_line '✓' "$GREEN" 'Kernel' 'migrated to uwu_kernel'
    else
        status_line '!' "$YELLOW" 'Kernel' 'migration requires manual review'
    fi

    printf 'Next step: lunch %s-cp2a-userdebug\n' "$UWU_PRODUCT"
}

declare -a CLI_ARGS=()
while (( $# )); do
    case "$1" in
        --language)
            [[ $# -ge 2 ]] || die "--language requires a value" 2
            LANGUAGE="$2"
            shift 2
            ;;
        *)
            CLI_ARGS+=("$1")
            shift
            ;;
    esac
done
[[ -z "$LANGUAGE" ]] || validate_language
set -- "${CLI_ARGS[@]}"
if (( $# > 0 )) && [[ -z "$LANGUAGE" ]]; then
    LANGUAGE=en
fi

if [[ $# -ge 2 && "$1" == inspect && "$2" == soong-only ]]; then
    shift 2
    inspect_soong_only "$@"
elif [[ $# -ge 2 && "$1" == inspect && "$2" == elf ]]; then
    shift 2
    inspect_elf "$@"
elif [[ $# -ge 3 && "$1" == vendor && "$2" == convert && "$3" == radio ]]; then
    shift 3
    vendor_convert_radio_main "$@"
elif [[ $# -ge 2 && "$1" == kernel && "$2" == migrate ]]; then
    shift 2
    kernel_migrate_main "$@"
elif [[ $# -eq 0 ]]; then
    [[ -n "$LANGUAGE" ]] || choose_language
    if choose_main_action; then
        main product migrate lineage apply
    else
        inspect_elf
    fi
elif [[ "$1" == --help || "$1" == -h ]]; then
    global_usage
    exit 0
else
    main "$@"
fi
