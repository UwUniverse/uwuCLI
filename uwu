print_banner() {
    [[ "$FORMAT" == text ]] || return 0
    local title="Product migration"
    local description="Convert a LineageOS product tree into an uwuAOSP device tree"
    case "${1:-migration}" in
        cli)
            title="Developer toolkit"
            description="Tools for uwuAOSP device bring-up and development"
            ;;
        elf)
            title="ELF inspection"
            description="Check extracted proprietary ELF files without running Soong or Ninja"
            ;;
        kernel)
            title="Kernel migration"
            description="Convert legacy kernel BoardConfig settings to uwu_kernel"
            ;;
        soong-only)
            title="Soong-only readiness"
            description="Find product packages that still depend on Make"
            ;;
    esac
    if [[ "$LANGUAGE" == zh ]]; then
        case "${1:-migration}" in
            cli) title="开发者工具"; description="用于 uwuAOSP 设备适配与开发的工具集" ;;
            elf) title="ELF 检查"; description="无需运行 Soong 或 Ninja 即可检查已提取的专有 ELF 文件" ;;
            kernel) title="内核迁移"; description="将 legacy BoardConfig 内核配置转换为 uwu_kernel" ;;
            soong-only) title="Soong-only 就绪度"; description="查找仍依赖 Make 的产品 package" ;;
            *) title="产品迁移"; description="将 LineageOS 产品设备树转换为 uwuAOSP 设备树" ;;
        esac
    fi
    printf '\n  '
    if $TRUECOLOR; then
        printf '%s%su' "$BRAND_1" "$BOLD"
        printf '%s%sw' "$BRAND_2" "$BOLD"
        printf '%s%su' "$BRAND_3" "$BOLD"
        printf '%s%sA' "$BRAND_4" "$BOLD"
        printf '%s%sO' "$BRAND_5" "$BOLD"
        printf '%s%sS' "$BRAND_6" "$BOLD"
        printf '%s%sP%s\n' "$BRAND_7" "$BOLD" "$RESET"
    else
        printf '%suwuAOSP%s\n' "${CYAN}${BOLD}" "$RESET"
    fi
    printf '%s\n' "${BOLD}  $title${RESET}"
    printf '%s\n' "${DIM}  $description${RESET}"
    printf '%s\n\n' "${DIM}  source: $(basename "$SOURCE_ROOT")${RESET}"
}

step() {
    [[ "$FORMAT" == text ]] || return 0
    printf '%s %s\n' "${BLUE}${BOLD}==>${RESET}" "$1"
}

section() {
    [[ "$FORMAT" == text ]] || return 0
    printf '\n%s\n' "${BOLD}$1${RESET}"
    printf '%s\n' "${DIM}$(printf '%*s' "${#1}" '' | tr ' ' '-')${RESET}"
}

status_line() {
    [[ "$FORMAT" == text ]] || return 0
    local icon="$1" color="$2" label="$3"
    shift 3
    case "$icon" in
        '✓') icon='[ok]' ;;
        '!') icon='[!]' ;;
        '→') icon='->' ;;
        '•') icon='*' ;;
    esac
    printf '  %s%s%s %-15s%s %s\n' "$color" "$icon" "$RESET" "$label" "$RESET" "$*"
}

