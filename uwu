inspect_soong_only() {
    local output_format=text
    local -a args=()
    while (( $# )); do
        case "$1" in
            --device|--product|--out-dir|--format)
                [[ $# -ge 2 ]] || die "$1 requires a value" 2
                [[ "$1" != --format ]] || output_format="$2"
                args+=("$1" "$2")
                shift 2
                ;;
            --all-variants|--show-ready)
                args+=("$1")
                shift
                ;;
            -h|--help)
                soong_only_usage
                return 0
                ;;
            *) die "Unknown option: $1" 2 ;;
        esac
    done
    require_source_tree
    if [[ "$output_format" == text ]]; then
        print_banner soong-only
    fi
    python3 "$SCRIPT_DIR/soong_only_packages.py" --language "$LANGUAGE" "${args[@]}"
}

msg() {
    if [[ "$LANGUAGE" == "zh" ]]; then
        case "$1" in
            found) printf '%s\n' "${CYAN}找到 $2 个可转换产品设备树${RESET}" ;;
            no_candidates) printf '未找到可转换的 LineageOS 产品设备树。\n' ;;
            select) printf '%s\n' "${BOLD}选择产品设备树：${RESET}" ;;
            type) printf '设备类型（phone/tablet/foldable）：' ;;
            telephony) printf '是否支持移动数据？[y/N]：' ;;
            plan) section '迁移计划' ;;
            confirm) printf '\n%s ' "${YELLOW}${BOLD}应用这些修改？ [y/N]${RESET}" ;;
            success) printf '\n%s\n' "${GREEN}${BOLD}迁移成功${RESET}: $2" ;;
            unchanged) printf '未修改任何文件。\n' ;;
            vendor_missing) printf '%s\n' "${YELLOW}未找到 vendor 生成目录：$2。请先运行 LineageOS 提取脚本设置 vendor tree；radio files 的转换需待 vendor tree 就绪后在 uwuAOSP 编译系统中完成。${RESET}" ;;
            radio_confirm) printf '\n%s ' "${YELLOW}${BOLD}是否将 radio files 转换为 uwu_prebuilt_image？ [y/N]${RESET}" ;;
            radio_none) printf '%s\n' "${CYAN}$2 中未发现需要转换的 radio files${RESET}" ;;
            radio_success) printf '%s\n' "${GREEN}${BOLD}Radio 转换完成${RESET}: $2 个镜像" ;;
            *) printf '%s\n' "$2" ;;
        esac
    else
        case "$1" in
            found) printf '%s\n' "${CYAN}Found $2 convertible product tree(s)${RESET}" ;;
            no_candidates) printf 'No convertible LineageOS product tree was found.\n' ;;
            select) printf '%s\n' "${BOLD}Select a product tree:${RESET}" ;;
            type) printf 'Device type (phone/tablet/foldable): ' ;;
            telephony) printf 'Does this device support mobile data? [y/N]: ' ;;
            plan) section 'Migration plan' ;;
            confirm) printf '\n%s ' "${YELLOW}${BOLD}Apply these changes? [y/N]${RESET}" ;;
            success) printf '\n%s\n' "${GREEN}${BOLD}Migration succeeded${RESET}: $2" ;;
            unchanged) printf 'No files were changed.\n' ;;
            vendor_missing) printf '%s\n' "${YELLOW}Vendor generated directory not found: $2. Run the LineageOS extraction scripts to set up the vendor tree first; radio files must then be converted within the uwuAOSP build system.${RESET}" ;;
            radio_confirm) printf '\n%s ' "${YELLOW}${BOLD}Convert radio files to uwu_prebuilt_image? [y/N]${RESET}" ;;
            radio_none) printf '%s\n' "${CYAN}No radio files to convert in $2${RESET}" ;;
            radio_success) printf '%s\n' "${GREEN}${BOLD}Radio migration succeeded${RESET}: $2 image(s)" ;;
            *) printf '%s\n' "$2" ;;
        esac
    fi
}

choose_main_action() {
    local choice
    while true; do
        if [[ "$LANGUAGE" == zh ]]; then
            printf '\n%s\n' "${BOLD}你想进行什么操作？${RESET}"
            printf '  %s1%s) 改造 LineageOS 产品设备树\n' "$CYAN" "$RESET"
            printf '  %s2%s) 检查专有 ELF 文件\n' "$CYAN" "$RESET"
            printf '\n请选择操作：'
        else
            printf '\n%s\n' "${BOLD}What would you like to do?${RESET}"
            printf '  %s1%s) Migrate a LineageOS product tree\n' "$CYAN" "$RESET"
            printf '  %s2%s) Check proprietary ELF files\n' "$CYAN" "$RESET"
            printf '\nSelect an action: '
        fi
        if ! IFS= read -r choice; then
            die 'No input received.'
        fi
        case "$choice" in
            1|migrate|migration)
                return 0
                ;;
            2|elf|check)
                return 1
                ;;
            *)
                if [[ "$LANGUAGE" == zh ]]; then
                    printf '%s\n' "${RED}选择无效，请输入 1 或 2。${RESET}" >&2
                else
                    printf '%s\n' "${RED}Invalid selection. Choose 1 or 2.${RESET}" >&2
                fi
                ;;
        esac
    done
}

choose_language() {
    local choice
    while true; do
        printf '\n%s\n' "${BOLD}Choose a language / 选择语言${RESET}"
        printf '  %s1%s) English\n' "$CYAN" "$RESET"
        printf '  %s2%s) 简体中文\n' "$CYAN" "$RESET"
        printf '\n> '
        if ! IFS= read -r choice; then
            die 'No input received / 未收到输入'
        fi
        case "$choice" in
            1|en|English|english)
                LANGUAGE=en
                return
                ;;
            2|zh|简体中文|中文)
                LANGUAGE=zh
                return
                ;;
            *)
                printf '%s\n' "${RED}Invalid selection / 选择无效${RESET}" >&2
                ;;
        esac
    done
}

validate_language() {
    [[ "$LANGUAGE" == en || "$LANGUAGE" == zh ]] || die "Unsupported language: $LANGUAGE" 2
}

die() {
    printf 'Error: %s\n' "$1" >&2
    msg unchanged >&2
    exit "${2:-1}"
}

relative_path() { printf '%s' "${1#"$SOURCE_ROOT"/}"; }

require_source_tree() {
    [[ -f "$SOURCE_ROOT/build/envsetup.sh" && -f "$SOURCE_ROOT/vendor/uwu/config/common.mk" ]] || \
        die "This command must run from an uwuAOSP source tree containing build/envsetup.sh and vendor/uwu/config/common.mk."
    command -v awk >/dev/null || die "Required command not found: awk" 6
    command -v grep >/dev/null || die "Required command not found: grep" 6
    command -v diff >/dev/null || die "Required command not found: diff" 6
}

find_candidates() {
    local file reason
    CANDIDATES=()
    SKIPPED=()
    while IFS= read -r -d '' file; do
        reason=""
        if ! grep -Eq -- "$LINEAGE_COMMON_RE" "$file"; then
            reason="missing LineageOS common configuration"
        elif [[ ! -f "$(dirname -- "$file")/AndroidProducts.mk" ]]; then
            reason="missing AndroidProducts.mk"
        fi
        if [[ -n "$reason" ]]; then
            SKIPPED+=("$(relative_path "$file")|$reason")
        else
            CANDIDATES+=("$file")
        fi
    done < <(find "$SOURCE_ROOT/device" -mindepth 3 -maxdepth 3 -type f -name 'lineage_*.mk' -print0 2>/dev/null)
}

find_elf_device_dirs() {
    local directory
    CANDIDATES=()
    while IFS= read -r -d '' directory; do
        [[ -f "$directory/extract-files.py" &&
           -f "$directory/AndroidProducts.mk" &&
           -f "$directory/proprietary-files.txt" ]] || continue
        CANDIDATES+=("$directory")
    done < <(find "$SOURCE_ROOT/device" -mindepth 2 -maxdepth 2 -type d -print0 2>/dev/null)
}

select_elf_device() {
    local choice index directory name
    if [[ -n "${ELF_DEVICE_DIR:-}" ]]; then
        [[ "$ELF_DEVICE_DIR" = /* ]] || ELF_DEVICE_DIR="$SOURCE_ROOT/$ELF_DEVICE_DIR"
        ELF_DEVICE_DIR="$(cd -- "$ELF_DEVICE_DIR" 2>/dev/null && pwd -P)" || \
            die "Device directory not found: ${ELF_DEVICE_DIR#"$SOURCE_ROOT"/}"
        return
    fi
    if [[ -n "${ELF_DEVICE:-}" ]]; then
        for directory in "${CANDIDATES[@]}"; do
            name="$(basename "$directory")"
            [[ "$name" == "$ELF_DEVICE" ]] || continue
            if [[ -n "${ELF_DEVICE_DIR_MATCH:-}" ]]; then
                die "Multiple device trees match '$ELF_DEVICE'; specify --device-dir."
            fi
            ELF_DEVICE_DIR_MATCH="$directory"
        done
        [[ -n "${ELF_DEVICE_DIR_MATCH:-}" ]] || die "No ELF-checkable device tree found for '$ELF_DEVICE'."
        ELF_DEVICE_DIR="$ELF_DEVICE_DIR_MATCH"
        return
    fi
    (( ${#CANDIDATES[@]} > 0 )) || die "No ELF-checkable device trees were found."
    if (( ${#CANDIDATES[@]} == 1 )); then
        ELF_DEVICE_DIR="${CANDIDATES[0]}"
        return
    fi
    $ELF_NON_INTERACTIVE && die "Multiple device trees found; specify --device or --device-dir."
    section 'Available device trees'
    for index in "${!CANDIDATES[@]}"; do
        directory="${CANDIDATES[$index]}"
        printf '  %s%s%s  %-20s %s\n' "$CYAN" "$((index + 1))" "$RESET" \
            "$(basename "$directory")" "${DIM}$(relative_path "$directory")${RESET}"
    done
    while true; do
        printf 'Select a device: '
        read -r choice || die "No input received."
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#CANDIDATES[@]} )); then
            ELF_DEVICE_DIR="${CANDIDATES[$((choice - 1))]}"
            return
        fi
        printf '%s\n' "${RED}Invalid selection.${RESET}" >&2
    done
}

validate_elf_device() {
    local relative device_vendor vendor_root
    [[ "$ELF_DEVICE_DIR" == "$SOURCE_ROOT/device/"* ]] || \
        die "Device directory must be inside the source tree's device/ directory."
    [[ -f "$ELF_DEVICE_DIR/extract-files.py" ]] || die "Missing extract-files.py in $(relative_path "$ELF_DEVICE_DIR")."
    [[ -f "$ELF_DEVICE_DIR/AndroidProducts.mk" ]] || die "Missing AndroidProducts.mk in $(relative_path "$ELF_DEVICE_DIR")."
    [[ -f "$ELF_DEVICE_DIR/proprietary-files.txt" ]] || die "Missing proprietary-files.txt in $(relative_path "$ELF_DEVICE_DIR")."
    relative="${ELF_DEVICE_DIR#"$SOURCE_ROOT/device/"}"
    device_vendor="${relative%%/*}"
    vendor_root="$SOURCE_ROOT/vendor/$device_vendor/$(basename "$ELF_DEVICE_DIR")"
    [[ -f "$vendor_root/Android.bp" ]] || die "Missing generated file: $(relative_path "$vendor_root/Android.bp"). Run setup-makefiles.py first."
}

run_elf_check() {
    local relative_device
    local -a command=(python3 "$SCRIPT_DIR/standalone_check_elf.py")
    relative_device="$(relative_path "$ELF_DEVICE_DIR")"
    command+=("$relative_device")
    [[ -n "${ELF_PRODUCT:-}" ]] && command+=(--product "$ELF_PRODUCT")
    [[ -n "${ELF_JOBS:-}" ]] && command+=(--jobs "$ELF_JOBS")
    $ELF_FAIL_FAST && command+=(--fail-fast)
    $ELF_INCREMENTAL && command+=(--incremental)
    $ELF_NO_BANNER && command+=(--no-banner)
    step 'Running standalone ELF checker'
    (cd -- "$SOURCE_ROOT" && exec "${command[@]}")
}

inspect_elf() {
    ELF_DEVICE=""
    ELF_DEVICE_DIR=""
    ELF_DEVICE_DIR_MATCH=""
    ELF_PRODUCT=""
    ELF_JOBS=""
    ELF_FAIL_FAST=false
    ELF_INCREMENTAL=false
    ELF_NON_INTERACTIVE=false
    ELF_NO_BANNER=false
    while (( $# )); do
        case "$1" in
            --device) [[ $# -ge 2 ]] || die "--device requires a value" 2; ELF_DEVICE="$2"; shift 2 ;;
            --device-dir) [[ $# -ge 2 ]] || die "--device-dir requires a value" 2; ELF_DEVICE_DIR="$2"; shift 2 ;;
            --product) [[ $# -ge 2 ]] || die "--product requires a value" 2; ELF_PRODUCT="$2"; shift 2 ;;
            -j|--jobs) [[ $# -ge 2 ]] || die "--jobs requires a value" 2; ELF_JOBS="$2"; [[ "$ELF_JOBS" =~ ^[0-9]+$ && "$ELF_JOBS" -ge 1 ]] || die "--jobs must be at least 1" 2; shift 2 ;;
            --fail-fast) ELF_FAIL_FAST=true; shift ;;
            --incremental) ELF_INCREMENTAL=true; shift ;;
            --non-interactive) ELF_NON_INTERACTIVE=true; shift ;;
            --no-banner) ELF_NO_BANNER=true; shift ;;
            -h|--help) elf_usage; return 0 ;;
            *) die "Unknown ELF option: $1" 2 ;;
        esac
    done
    require_source_tree
    [[ -f "$SCRIPT_DIR/standalone_check_elf.py" ]] || die "Missing CLI component: $SCRIPT_DIR/standalone_check_elf.py"
    command -v python3 >/dev/null || die "Required command not found: python3" 6
    step 'Discovering device trees'
    find_elf_device_dirs
    select_elf_device
    validate_elf_device
    status_line '✓' "$GREEN" 'Device' "$(relative_path "$ELF_DEVICE_DIR")"
    status_line '✓' "$GREEN" 'Prerequisites' 'passed'
    run_elf_check
}

print_candidates() {
    local file name item
    if [[ "$FORMAT" == json ]]; then
        printf '{"convertible":['
        local first=true
        for file in "${CANDIDATES[@]}"; do
            name="$(basename "$file" .mk)"
            name="${name#lineage_}"
            $first || printf ','
            printf '{"device":"%s","path":"%s"}' "$name" "$(relative_path "$file")"
            first=false
        done
        printf '],"skipped":['
        first=true
        for item in "${SKIPPED[@]}"; do
            $first || printf ','
            printf '{"path":"%s","reason":"%s"}' "${item%%|*}" "${item#*|}"
            first=false
        done
        printf ']}\n'
        return 0
    fi
    section 'Available product trees'
    msg found "${#CANDIDATES[@]}"
    if (( ${#CANDIDATES[@]} )); then
        printf '\n%s\n' "${GREEN}${BOLD}Convertible${RESET}"
        for file in "${CANDIDATES[@]}"; do
            name="$(basename "$file" .mk)"
            name="${name#lineage_}"
            status_line '✓' "$GREEN" "$name" "$(relative_path "$file")"
        done
    fi
    if (( ${#SKIPPED[@]} )); then
        printf '\n%s\n' "${YELLOW}${BOLD}Skipped${RESET}"
        for item in "${SKIPPED[@]}"; do
            status_line '!' "$YELLOW" "${item%%|*}" "${item#*|}"
        done
    fi
    return 0
}

select_product() {
    local choice index file name
    if [[ -n "$PRODUCT_FILE" ]]; then
        [[ "$PRODUCT_FILE" = /* ]] || PRODUCT_FILE="$SOURCE_ROOT/$PRODUCT_FILE"
        [[ -f "$PRODUCT_FILE" ]] || die "Product file not found: $(relative_path "$PRODUCT_FILE")"
        SELECTED_PRODUCT_FILE="$PRODUCT_FILE"
        return
    fi
    if [[ -n "$DEVICE" ]]; then
        for file in "${CANDIDATES[@]}"; do
            name="$(basename "$file" .mk)"
            if [[ "${name#lineage_}" == "$DEVICE" ]]; then
                SELECTED_PRODUCT_FILE="$file"
                return
            fi
        done
        die "No convertible product tree found for device '$DEVICE'. Run 'uwu product migrate lineage list'."
    fi
    (( ${#CANDIDATES[@]} > 0 )) || die "No convertible product tree was found."
    if (( ${#CANDIDATES[@]} == 1 )); then
        SELECTED_PRODUCT_FILE="${CANDIDATES[0]}"
        status_line '✓' "$GREEN" 'Selected' "$(relative_path "$SELECTED_PRODUCT_FILE")"
        return
    fi
    $NON_INTERACTIVE && die "Multiple product trees found; specify --device or --product-file."
    msg select
    for index in "${!CANDIDATES[@]}"; do
        file="${CANDIDATES[$index]}"
        name="$(basename "$file" .mk)"
        printf '  %s%s%s  %-20s %s\n' "$CYAN" "$((index + 1))" "$RESET" "${name#lineage_}" "${DIM}$(relative_path "$file")${RESET}"
    done
    while true; do
        read -r -p '> ' choice || die "No input received."
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#CANDIDATES[@]} )); then
            SELECTED_PRODUCT_FILE="${CANDIDATES[$((choice - 1))]}"
            return
        fi
        printf 'Invalid selection.\n' >&2
    done
}

ask_options() {
    local answer
    while true; do
        if [[ -z "$DEVICE_TYPE" ]]; then
            $NON_INTERACTIVE && die "Specify --type in non-interactive mode."
            msg type
            read -r DEVICE_TYPE || die "No input received."
        fi
        if [[ "$DEVICE_TYPE" =~ ^(phone|tablet|foldable)$ ]]; then
            break
        fi
        if $NON_INTERACTIVE; then
            die "Invalid device type '$DEVICE_TYPE'; expected phone, tablet, or foldable."
        fi
        printf '%s\n' "${RED}Invalid device type '$DEVICE_TYPE'. Choose phone, tablet, or foldable.${RESET}" >&2
        DEVICE_TYPE=""
    done
    status_line '✓' "$GREEN" 'Device type' "$DEVICE_TYPE"
    if [[ -z "$SUPPORTS_TELEPHONY" ]]; then
        $NON_INTERACTIVE && die "Specify --telephony or --no-telephony in non-interactive mode."
        msg telephony; read -r answer || die "No input received."
        case "$answer" in y|Y|yes|Yes) SUPPORTS_TELEPHONY=true ;; *) SUPPORTS_TELEPHONY=false ;; esac
    fi
    status_line '✓' "$GREEN" 'Telephony' "$SUPPORTS_TELEPHONY"
}

validate_product() {
    DEVICE_DIR="$(dirname -- "$SELECTED_PRODUCT_FILE")"
    ANDROID_PRODUCTS_FILE="$DEVICE_DIR/AndroidProducts.mk"
    PRODUCT_BASENAME="$(basename -- "$SELECTED_PRODUCT_FILE" .mk)"
    PRODUCT_SUFFIX="${PRODUCT_BASENAME#lineage_}"
    LINEAGE_PRODUCT="lineage_$PRODUCT_SUFFIX"
    UWU_PRODUCT="uwu_$PRODUCT_SUFFIX"
    UWU_PRODUCT_FILE="$DEVICE_DIR/$UWU_PRODUCT.mk"
    [[ "$PRODUCT_BASENAME" == lineage_* && "$PRODUCT_SUFFIX" =~ ^[A-Za-z0-9_]+$ ]] || die "Invalid product codename: $PRODUCT_SUFFIX"
    [[ -f "$ANDROID_PRODUCTS_FILE" ]] || die "Missing file: $(relative_path "$ANDROID_PRODUCTS_FILE")"
    [[ ! -e "$UWU_PRODUCT_FILE" ]] || die "Target file already exists: $(relative_path "$UWU_PRODUCT_FILE")"
    [[ "$(grep -Ec -- "$LINEAGE_COMMON_RE" "$SELECTED_PRODUCT_FILE")" == 1 ]] || die "Product file must contain exactly one LineageOS common configuration entry."
    [[ "$(grep -Ec '^[[:space:]]*PRODUCT_NAME[[:space:]]*(:|\+|\?)?=[[:space:]]*lineage_' "$SELECTED_PRODUCT_FILE")" == 1 ]] || die "Product file must contain exactly one lineage_ PRODUCT_NAME."
    [[ "$(grep -Fc -- "$LINEAGE_PRODUCT.mk" "$ANDROID_PRODUCTS_FILE")" == 1 ]] || die "AndroidProducts.mk must reference $LINEAGE_PRODUCT.mk exactly once."
}

make_plan() {
    PRODUCT_TMP="$(mktemp "$DEVICE_DIR/.uwu-product.XXXXXX")"
    ANDROID_PRODUCTS_TMP="$(mktemp "$DEVICE_DIR/.uwu-products.XXXXXX")"
    chmod --reference="$SELECTED_PRODUCT_FILE" "$PRODUCT_TMP" "$ANDROID_PRODUCTS_TMP"
    local common_line common_path
    common_line="$(grep -En -- "$LINEAGE_COMMON_RE" "$SELECTED_PRODUCT_FILE" | cut -d: -f1)"
    common_path="$(grep -Eo 'vendor/lineage/config/common[^[:space:])]*\.mk' "$SELECTED_PRODUCT_FILE" | head -n1)"
    awk -v common_line="$common_line" -v device_type="$DEVICE_TYPE" -v telephony="$SUPPORTS_TELEPHONY" -v old="$LINEAGE_PRODUCT" -v new="$UWU_PRODUCT" '
        NR == common_line { print "UWU_DEVICE_TYPE := " device_type; print "UWU_SUPPORTS_TELEPHONY := " telephony; print "$(call inherit-product, vendor/uwu/config/common.mk)"; next }
        { if ($0 == "# Inherit some common LineageOS stuff.") $0 = "# Inherit some common uwuAOSP stuff."; if ($0 ~ /^[[:space:]]*PRODUCT_NAME[[:space:]]*(:|\+|\?)?=[[:space:]]*lineage_/) sub(/lineage_/, "uwu_"); gsub(old, new); print }
    ' "$SELECTED_PRODUCT_FILE" > "$PRODUCT_TMP"
    awk -v old="$LINEAGE_PRODUCT" -v new="$UWU_PRODUCT" '{ gsub(old "\\.mk", new ".mk"); gsub(old "-[A-Za-z0-9_.]+-userdebug", new "-cp2a-userdebug"); gsub(old "-userdebug", new "-cp2a-userdebug"); gsub(old "-[A-Za-z0-9_.]+-user", new "-cp2a-user"); gsub(old "-user", new "-cp2a-user"); gsub(old "-[A-Za-z0-9_.]+-eng", new "-cp2a-eng"); gsub(old "-eng", new "-cp2a-eng"); print }' "$ANDROID_PRODUCTS_FILE" > "$ANDROID_PRODUCTS_TMP"
    grep -Fq '$(call inherit-product, vendor/uwu/config/common.mk)' "$PRODUCT_TMP" || die "Generated product file failed validation."
    grep -Eq '^[[:space:]]*PRODUCT_NAME[[:space:]]*(:|\+|\?)?=[[:space:]]*uwu_' "$PRODUCT_TMP" || die "Generated PRODUCT_NAME failed validation."
    ! grep -Fq "$LINEAGE_PRODUCT.mk" "$ANDROID_PRODUCTS_TMP" || die "Generated AndroidProducts.mk still references $LINEAGE_PRODUCT.mk."
    grep -Fq "$UWU_PRODUCT.mk" "$ANDROID_PRODUCTS_TMP" || die "Generated AndroidProducts.mk lost the product reference."
    LINEAGE_COMMON_PATH="$common_path"
}

print_diff() {
    printf '\n  %s -> %s\n' "$(relative_path "$SELECTED_PRODUCT_FILE")" "$(relative_path "$UWU_PRODUCT_FILE")"
    diff -u -- "$SELECTED_PRODUCT_FILE" "$PRODUCT_TMP" || true
    printf '\n  %s\n' "$(relative_path "$ANDROID_PRODUCTS_FILE")"
    diff -u -- "$ANDROID_PRODUCTS_FILE" "$ANDROID_PRODUCTS_TMP" || true
}

print_plan() {
    msg plan
    status_line '•' "$CYAN" 'Device' "${DEVICE:-$PRODUCT_SUFFIX}"
    status_line '•' "$CYAN" 'Device type' "$DEVICE_TYPE"
    status_line '•' "$CYAN" 'Telephony' "$SUPPORTS_TELEPHONY"
    status_line '→' "$CYAN" 'Product' "$LINEAGE_PRODUCT -> $UWU_PRODUCT"
    status_line '→' "$CYAN" 'Lunch targets' "$LINEAGE_PRODUCT -> $UWU_PRODUCT-cp2a-*"
    status_line '→' "$CYAN" 'Common config' "$LINEAGE_COMMON_PATH -> vendor/uwu/config/common.mk"
    section 'Changes'
    print_diff
}

apply_plan() {
    local product_backup products_backup
    product_backup="$(mktemp "$DEVICE_DIR/.uwu-product-backup.XXXXXX")"
    products_backup="$(mktemp "$DEVICE_DIR/.uwu-products-backup.XXXXXX")"
    cp -p -- "$SELECTED_PRODUCT_FILE" "$product_backup"
    cp -p -- "$ANDROID_PRODUCTS_FILE" "$products_backup"
    rollback() {
        cp -p -- "$product_backup" "$SELECTED_PRODUCT_FILE" 2>/dev/null || true
        cp -p -- "$products_backup" "$ANDROID_PRODUCTS_FILE" 2>/dev/null || true
        rm -f -- "$UWU_PRODUCT_FILE"
    }
    if ! mv -- "$PRODUCT_TMP" "$UWU_PRODUCT_FILE" || ! mv -- "$ANDROID_PRODUCTS_TMP" "$ANDROID_PRODUCTS_FILE" || ! rm -f -- "$SELECTED_PRODUCT_FILE"; then
        rollback
        die "Failed to apply migration; original files were restored."
    fi
    rm -f -- "$product_backup" "$products_backup"
    PRODUCT_TMP=""
    ANDROID_PRODUCTS_TMP=""
}

confirm_apply() {
    $YES && return 0
    $NON_INTERACTIVE && die "Use --yes with --apply in non-interactive mode."
    msg confirm
    local answer
    read -r answer || die "No input received."
    [[ "$answer" =~ ^(y|Y|yes|Yes)$ ]] || { msg unchanged; exit 0; }
}

vendor_root_from_device_dir() {
    local device_dir="$1" relative device_vendor device_name
    relative="${device_dir#"$SOURCE_ROOT/device/"}"
    device_vendor="${relative%%/*}"
    device_name="${relative#*/}"
    printf '%s' "$SOURCE_ROOT/vendor/$device_vendor/$device_name"
}

extract_ab_ota_partitions() {
    # Extract the partition names listed under AB_OTA_PARTITIONS in a
    # generated BoardConfigVendor.mk file.
    awk '/^AB_OTA_PARTITIONS/{f=1;next} f && /^[[:space:]]/{gsub(/^[[:space:]]+/,""); gsub(/[[:space:]]+\\?$/,""); if ($0!="") print; next} f{f=0}' "$1"
}

vendor_convert_radio() {
    local device_dir="$1"
    local vendor_root
    vendor_root="$(vendor_root_from_device_dir "$device_dir")"

    if [[ ! -d "$vendor_root" ]]; then
        status_line '!' "$YELLOW" 'Vendor tree' 'missing'
        msg vendor_missing "$(relative_path "$vendor_root")"
        return 1
    fi

    local android_mk="$vendor_root/Android.mk"
    if [[ ! -f "$android_mk" ]] || ! grep -q 'add-radio-file-sha1-checked' "$android_mk"; then
        msg radio_none "$(relative_path "$vendor_root")"
        return 0
    fi

    local -a radio_paths radio_sha1s radio_names ab_parts
    local line path sha1 part

    while IFS= read -r line; do
        path="${line%%,*}"
        sha1="${line##*,}"
        radio_paths+=("$path")
        radio_sha1s+=("$sha1")
    done < <(grep -o 'add-radio-file-sha1-checked,[^)]*' "$android_mk" | sed 's/^add-radio-file-sha1-checked,//')

    while IFS= read -r part; do
        [[ -n "$part" ]] || continue
        ab_parts+=("$part")
    done < <(extract_ab_ota_partitions "$vendor_root/BoardConfigVendor.mk")

    local i n="${#radio_paths[@]}"
    for (( i = 0; i < n; i++ )); do
        local name=""
        if (( i < ${#ab_parts[@]} )); then
            name="${ab_parts[$i]}"
        fi
        [[ -n "$name" ]] || name="$(basename "${radio_paths[$i]}" .img)"
        radio_names+=("$name")
    done

    if (( n == 0 )); then
        msg radio_none "$(relative_path "$vendor_root")"
        return 0
    fi

    local radio_bp="$vendor_root/radio/Android.bp"
    mkdir -p -- "$(dirname -- "$radio_bp")"
    {
        printf '//\n// Automatically generated file. DO NOT MODIFY\n//\n\n'
        for (( i = 0; i < n; i++ )); do
            printf 'uwu_prebuilt_image {\n    name: "%s",\n    src: "%s",\n    sha1: "%s",\n}\n\n' \
                "${radio_names[$i]}" "$(basename "${radio_paths[$i]}")" "${radio_sha1s[$i]}"
        done
    } > "$radio_bp"

    {
        printf '\nAB_OTA_RADIO_PARTITIONS += \\\n'
        for (( i = 0; i < n; i++ )); do
            if (( i == n - 1 )); then
                printf '    %s\n' "${radio_names[$i]}"
            else
                printf '    %s \\\n' "${radio_names[$i]}"
            fi
        done
    } >> "$vendor_root/BoardConfigVendor.mk"

    local vendor_mk="$vendor_root/$(basename -- "$device_dir")-vendor.mk"
    if [[ -f "$vendor_mk" ]]; then
        {
            printf '\nPRODUCT_PACKAGES += \\\n'
            for (( i = 0; i < n; i++ )); do
                if (( i == n - 1 )); then
                    printf '    %s\n' "${radio_names[$i]}"
                else
                    printf '    %s \\\n' "${radio_names[$i]}"
                fi
            done
        } >> "$vendor_mk"
    fi

    rm -f -- "$android_mk"

    status_line '✓' "$GREEN" 'Radio' "$n image(s) -> uwu_prebuilt_image"
    return 0
}

